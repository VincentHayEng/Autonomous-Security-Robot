// ======================================================
// WIFI SETTINGS
// ======================================================

#define WIFI_SSID       "Curvy's Z Fold5"
#define WIFI_PASSWORD   "Zarazira2"

#define UDP_PORT        5005
#define TAG             "ROBOT_ODOM"

// ======================================================
// BTS7960 MOTOR PINS
// ======================================================

// Left motor driver
#define LEFT_RPWM       GPIO_NUM_25
#define LEFT_LPWM       GPIO_NUM_26
#define LEFT_REN        GPIO_NUM_27
#define LEFT_LEN        GPIO_NUM_14

// Right motor driver
#define RIGHT_RPWM      GPIO_NUM_32
#define RIGHT_LPWM      GPIO_NUM_33
#define RIGHT_REN       GPIO_NUM_18
#define RIGHT_LEN       GPIO_NUM_19

// ======================================================
// ENCODER PINS
// ======================================================

#define LEFT_ENCODER_PIN   GPIO_NUM_34
#define RIGHT_ENCODER_PIN  GPIO_NUM_35

// ======================================================
// UART TO RASPBERRY PI
// ======================================================

#define PI_UART_PORT       UART_NUM_2
#define PI_UART_TX_PIN     GPIO_NUM_17
#define PI_UART_RX_PIN     GPIO_NUM_16
#define PI_UART_BAUD       115200

// ======================================================
// PWM SETTINGS
// ======================================================

#define PWM_FREQ        1000
#define PWM_RESOLUTION  LEDC_TIMER_8_BIT
#define PWM_MAX         255

#define LEFT_RPWM_CH    LEDC_CHANNEL_0
#define LEFT_LPWM_CH    LEDC_CHANNEL_1
#define RIGHT_RPWM_CH   LEDC_CHANNEL_2
#define RIGHT_LPWM_CH   LEDC_CHANNEL_3

// ======================================================
// ROBOT CALIBRATION
// ======================================================

// Your measured average from the encoder tests.
#define COUNTS_PER_REVOLUTION   518.5f

// Measure your actual wheel diameter.
// 0.072 m = 72 mm. Change this if your wheel is different.
#define WHEEL_DIAMETER_M        0.072f

// Measure centre-to-centre distance between left and right wheels.
// Example: 235 mm. Change this to your robot.
#define WHEEL_BASE_MM           235.0f

#define PI_VALUE                3.1415926f

// ======================================================
// POSE PACKET SENT TO RASPBERRY PI
// ======================================================

typedef struct __attribute__((packed))
{
    int32_t  x_mm;
    int32_t  y_mm;
    int32_t  theta_mrad;
    uint64_t timestamp_us;
    uint32_t seq;
} pose_t;

// ======================================================
// GLOBAL VARIABLES
// ======================================================

volatile int32_t left_encoder_count = 0;
volatile int32_t right_encoder_count = 0;

int motor_speed = 120;

// Direction is inferred from the motor command.
//  1 = forward
// -1 = reverse
//  0 = stopped
volatile int left_direction = 0;
volatile int right_direction = 0;

float robot_x_mm = 0.0f;
float robot_y_mm = 0.0f;
float robot_theta_rad = 0.0f;

uint32_t pose_seq = 0;

// ======================================================
// ENCODER INTERRUPTS
// ======================================================

void IRAM_ATTR left_encoder_isr_handler(void *arg)
{
    int32_t current_count = left_encoder_count;

    if (left_direction >= 0)
    {
        left_encoder_count = current_count + 1;
    }
    else
    {
        left_encoder_count = current_count - 1;
    }
}

void IRAM_ATTR right_encoder_isr_handler(void *arg)
{
    int32_t current_count = right_encoder_count;

    if (right_direction >= 0)
    {
        right_encoder_count = current_count + 1;
    }
    else
    {
        right_encoder_count = current_count - 1;
    }
}

// ======================================================
// PWM HELPER
// ======================================================

void set_pwm(ledc_channel_t channel, int duty)
{
    if (duty < 0)
    {
        duty = 0;
    }

    if (duty > PWM_MAX)
    {
        duty = PWM_MAX;
    }

    ledc_set_duty(LEDC_LOW_SPEED_MODE, channel, duty);
    ledc_update_duty(LEDC_LOW_SPEED_MODE, channel);
}

// ======================================================
// MOTOR FUNCTIONS
// ======================================================

void left_stop()
{
    set_pwm(LEFT_RPWM_CH, 0);
    set_pwm(LEFT_LPWM_CH, 0);
    left_direction = 0;
}

void right_stop()
{
    set_pwm(RIGHT_RPWM_CH, 0);
    set_pwm(RIGHT_LPWM_CH, 0);
    right_direction = 0;
}

void stop_all()
{
    left_stop();
    right_stop();
}

void left_forward()
{
    set_pwm(LEFT_RPWM_CH, motor_speed);
    set_pwm(LEFT_LPWM_CH, 0);
    left_direction = 1;
}

void left_reverse()
{
    set_pwm(LEFT_RPWM_CH, 0);
    set_pwm(LEFT_LPWM_CH, motor_speed);
    left_direction = -1;
}

void right_forward()
{
    set_pwm(RIGHT_RPWM_CH, motor_speed);
    set_pwm(RIGHT_LPWM_CH, 0);
    right_direction = 1;
}

void right_reverse()
{
    set_pwm(RIGHT_RPWM_CH, 0);
    set_pwm(RIGHT_LPWM_CH, motor_speed);
    right_direction = -1;
}

void move_forward()
{
    left_forward();
    right_forward();
}

void move_backward()
{
    left_reverse();
    right_reverse();
}

void turn_left()
{
    left_reverse();
    right_forward();
}

void turn_right()
{
    left_forward();
    right_reverse();
}

void only_left()
{
    left_forward();
    right_stop();
}

void only_right()
{
    left_stop();
    right_forward();
}

// ======================================================
// MOTOR SETUP
// ======================================================

void setup_motors()
{
    gpio_config_t enable_config;
    memset(&enable_config, 0, sizeof(enable_config));

    enable_config.intr_type = GPIO_INTR_DISABLE;
    enable_config.mode = GPIO_MODE_OUTPUT;
    enable_config.pin_bit_mask =
        (1ULL << LEFT_REN) |
        (1ULL << LEFT_LEN) |
        (1ULL << RIGHT_REN) |
        (1ULL << RIGHT_LEN);
    enable_config.pull_down_en = GPIO_PULLDOWN_DISABLE;
    enable_config.pull_up_en = GPIO_PULLUP_DISABLE;

    gpio_config(&enable_config);

    gpio_set_level(LEFT_REN, 1);
    gpio_set_level(LEFT_LEN, 1);
    gpio_set_level(RIGHT_REN, 1);
    gpio_set_level(RIGHT_LEN, 1);

    ledc_timer_config_t timer;
    memset(&timer, 0, sizeof(timer));

    timer.speed_mode = LEDC_LOW_SPEED_MODE;
    timer.timer_num = LEDC_TIMER_0;
    timer.duty_resolution = PWM_RESOLUTION;
    timer.freq_hz = PWM_FREQ;
    timer.clk_cfg = LEDC_AUTO_CLK;

    ledc_timer_config(&timer);

    ledc_channel_config_t ch;
    memset(&ch, 0, sizeof(ch));

    ch.speed_mode = LEDC_LOW_SPEED_MODE;
    ch.timer_sel = LEDC_TIMER_0;
    ch.duty = 0;
    ch.hpoint = 0;

    ch.channel = LEFT_RPWM_CH;
    ch.gpio_num = LEFT_RPWM;
    ledc_channel_config(&ch);

    ch.channel = LEFT_LPWM_CH;
    ch.gpio_num = LEFT_LPWM;
    ledc_channel_config(&ch);

    ch.channel = RIGHT_RPWM_CH;
    ch.gpio_num = RIGHT_RPWM;
    ledc_channel_config(&ch);

    ch.channel = RIGHT_LPWM_CH;
    ch.gpio_num = RIGHT_LPWM;
    ledc_channel_config(&ch);

    stop_all();

    ESP_LOGI(TAG, "Motor setup complete");
}

// ======================================================
// ENCODER SETUP
// ======================================================

void setup_encoders()
{
    gpio_config_t encoder_config;
    memset(&encoder_config, 0, sizeof(encoder_config));

    encoder_config.pin_bit_mask =
        (1ULL << LEFT_ENCODER_PIN) |
        (1ULL << RIGHT_ENCODER_PIN);

    encoder_config.mode = GPIO_MODE_INPUT;
    encoder_config.pull_up_en = GPIO_PULLUP_DISABLE;
    encoder_config.pull_down_en = GPIO_PULLDOWN_DISABLE;
    encoder_config.intr_type = GPIO_INTR_ANYEDGE;

    gpio_config(&encoder_config);

    esp_err_t isr_result = gpio_install_isr_service(0);

    if (isr_result == ESP_OK)
    {
        ESP_LOGI(TAG, "GPIO ISR service installed");
    }
    else if (isr_result == ESP_ERR_INVALID_STATE)
    {
        ESP_LOGW(TAG, "GPIO ISR service already installed");
    }
    else
    {
        ESP_LOGE(TAG, "GPIO ISR service install failed");
    }

    gpio_isr_handler_add(LEFT_ENCODER_PIN, left_encoder_isr_handler, NULL);
    gpio_isr_handler_add(RIGHT_ENCODER_PIN, right_encoder_isr_handler, NULL);

    ESP_LOGI(TAG, "Encoder setup complete");
}

// ======================================================
// UART SETUP FOR RASPBERRY PI
// ======================================================

void setup_pi_uart()
{
    uart_config_t uart_config;
    memset(&uart_config, 0, sizeof(uart_config));

    uart_config.baud_rate = PI_UART_BAUD;
    uart_config.data_bits = UART_DATA_8_BITS;
    uart_config.parity = UART_PARITY_DISABLE;
    uart_config.stop_bits = UART_STOP_BITS_1;
    uart_config.flow_ctrl = UART_HW_FLOWCTRL_DISABLE;
    uart_config.source_clk = UART_SCLK_DEFAULT;

    uart_driver_install(PI_UART_PORT, 1024, 1024, 0, NULL, 0);
    uart_param_config(PI_UART_PORT, &uart_config);
    uart_set_pin(PI_UART_PORT,
                 PI_UART_TX_PIN,
                 PI_UART_RX_PIN,
                 UART_PIN_NO_CHANGE,
                 UART_PIN_NO_CHANGE);

    ESP_LOGI(TAG, "UART2 to Raspberry Pi ready: TX=GPIO17 RX=GPIO16 baud=%d", PI_UART_BAUD);
}

// ======================================================
// WIFI SETUP
// ======================================================

void wifi_event_handler(void *arg, esp_event_base_t event_base,
                        int32_t event_id, void *event_data)
{
    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_START)
    {
        esp_wifi_connect();
    }
    else if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_DISCONNECTED)
    {
        ESP_LOGI(TAG, "Wi-Fi disconnected, reconnecting...");
        esp_wifi_connect();
    }
    else if (event_base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP)
    {
        ip_event_got_ip_t *event = (ip_event_got_ip_t *) event_data;
        ESP_LOGI(TAG, "ESP32 IP Address: " IPSTR, IP2STR(&event->ip_info.ip));
    }
}

void setup_wifi()
{
    nvs_flash_init();

    esp_netif_init();
    esp_event_loop_create_default();
    esp_netif_create_default_wifi_sta();

    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
    esp_wifi_init(&cfg);

    esp_event_handler_instance_register(WIFI_EVENT,
                                        ESP_EVENT_ANY_ID,
                                        &wifi_event_handler,
                                        NULL,
                                        NULL);

    esp_event_handler_instance_register(IP_EVENT,
                                        IP_EVENT_STA_GOT_IP,
                                        &wifi_event_handler,
                                        NULL,
                                        NULL);

    wifi_config_t wifi_config;
    memset(&wifi_config, 0, sizeof(wifi_config));

    strcpy((char *)wifi_config.sta.ssid, WIFI_SSID);
    strcpy((char *)wifi_config.sta.password, WIFI_PASSWORD);

    esp_wifi_set_mode(WIFI_MODE_STA);
    esp_wifi_set_config(WIFI_IF_STA, &wifi_config);
    esp_wifi_start();
}

// ======================================================
// ODOMETRY + UART POSE TASK
// ======================================================

void odometry_task(void *pvParameters)
{
    int32_t previous_left_count = 0;
    int32_t previous_right_count = 0;

    float wheel_circumference_mm = PI_VALUE * WHEEL_DIAMETER_M * 1000.0f;
    float mm_per_count = wheel_circumference_mm / COUNTS_PER_REVOLUTION;

    while (1)
    {
        int32_t current_left_count = left_encoder_count;
        int32_t current_right_count = right_encoder_count;

        int32_t left_delta_count = current_left_count - previous_left_count;
        int32_t right_delta_count = current_right_count - previous_right_count;

        previous_left_count = current_left_count;
        previous_right_count = current_right_count;

        float d_left_mm = left_delta_count * mm_per_count;
        float d_right_mm = right_delta_count * mm_per_count;

        float d_center_mm = (d_left_mm + d_right_mm) / 2.0f;

        // Positive theta means turning right by this convention.
        float d_theta_rad = (d_right_mm - d_left_mm) / WHEEL_BASE_MM;

        robot_theta_rad = robot_theta_rad + d_theta_rad;

        robot_x_mm = robot_x_mm + d_center_mm * sinf(robot_theta_rad);
        robot_y_mm = robot_y_mm + d_center_mm * cosf(robot_theta_rad);

        pose_t pose;

        pose.x_mm = (int32_t)robot_x_mm;
        pose.y_mm = (int32_t)robot_y_mm;
        pose.theta_mrad = (int32_t)(robot_theta_rad * 1000.0f);
        pose.timestamp_us = (uint64_t)esp_timer_get_time();
        pose.seq = pose_seq;
        pose_seq = pose_seq + 1;

        uart_write_bytes(PI_UART_PORT, (const char *)&pose, sizeof(pose_t));

        ESP_LOGI(TAG,
                 "POSE seq=%lu | x=%ld mm | y=%ld mm | theta=%ld mrad | L=%ld | R=%ld",
                 (unsigned long)pose.seq,
                 (long)pose.x_mm,
                 (long)pose.y_mm,
                 (long)pose.theta_mrad,
                 (long)current_left_count,
                 (long)current_right_count);

        vTaskDelay(pdMS_TO_TICKS(50));
    }
}

// ======================================================
// UDP KEYBOARD COMMAND TASK
// ======================================================

void udp_server_task(void *pvParameters)
{
    char receive_buffer[32];

    struct sockaddr_in server_addr;
    struct sockaddr_in client_addr;
    socklen_t client_addr_len = sizeof(client_addr);

    int sock = socket(AF_INET, SOCK_DGRAM, IPPROTO_IP);

    if (sock < 0)
    {
        ESP_LOGE(TAG, "Could not create UDP socket");
        vTaskDelete(NULL);
        return;
    }

    memset(&server_addr, 0, sizeof(server_addr));

    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = htonl(INADDR_ANY);
    server_addr.sin_port = htons(UDP_PORT);

    int bind_result = bind(sock, (struct sockaddr *)&server_addr, sizeof(server_addr));

    if (bind_result < 0)
    {
        ESP_LOGE(TAG, "Could not bind UDP socket");
        close(sock);
        vTaskDelete(NULL);
        return;
    }

    ESP_LOGI(TAG, "UDP server listening on port %d", UDP_PORT);

    while (1)
    {
        int length = recvfrom(sock,
                              receive_buffer,
                              sizeof(receive_buffer) - 1,
                              0,
                              (struct sockaddr *)&client_addr,
                              &client_addr_len);

        if (length < 0)
        {
            ESP_LOGE(TAG, "UDP receive error");
            continue;
        }

        receive_buffer[length] = '\0';

        char command = receive_buffer[0];

        if (command == 'w')
        {
            ESP_LOGI(TAG, "Command: forward");
            move_forward();
        }
        else if (command == 's')
        {
            ESP_LOGI(TAG, "Command: backward");
            move_backward();
        }
        else if (command == 'l')
        {
            ESP_LOGI(TAG, "Command: turn left");
            turn_left();
        }
        else if (command == 'r')
        {
            ESP_LOGI(TAG, "Command: turn right");
            turn_right();
        }
        else if (command == 'a')
        {
            ESP_LOGI(TAG, "Command: left motor only");
            only_left();
        }
        else if (command == 'd')
        {
            ESP_LOGI(TAG, "Command: right motor only");
            only_right();
        }
        else if (command == 'x' || command == ' ')
        {
            ESP_LOGI(TAG, "Command: stop");
            stop_all();
        }
        else if (command == '+')
        {
            motor_speed = motor_speed + 20;

            if (motor_speed > 255)
            {
                motor_speed = 255;
            }

            ESP_LOGI(TAG, "Speed increased to %d", motor_speed);
        }
        else if (command == '-')
        {
            motor_speed = motor_speed - 20;

            if (motor_speed < 0)
            {
                motor_speed = 0;
            }

            ESP_LOGI(TAG, "Speed decreased to %d", motor_speed);
        }
    }
}

// ======================================================
// MAIN
// ======================================================

extern "C" void app_main(void)
{
    ESP_LOGI(TAG, "Starting robot odometry + UART pose output");

    setup_motors();
    setup_encoders();
    setup_pi_uart();
    setup_wifi();

    xTaskCreate(odometry_task,
                "odometry_task",
                4096,
                NULL,
                5,
                NULL);

    xTaskCreate(udp_server_task,
                "udp_server_task",
                4096,
                NULL,
                5,
                NULL);
}
